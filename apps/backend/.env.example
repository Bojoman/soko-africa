# =============================================================================
# Soko Africa Backend Environment Variables
# =============================================================================

# ------------------------------------------------------------------------------
# Database Configuration (Required)
# ------------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soko_africa?schema=public"

# Database connection timeout in milliseconds (default: 30000)
DB_CONNECTION_TIMEOUT=30000

# Database connection pool size (default: 10)
DB_POOL_SIZE=10

# ------------------------------------------------------------------------------
# JWT Authentication (Required)
# ------------------------------------------------------------------------------
# JWT signing secret - MUST be at least 32 characters in production
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Rotate this value if you suspect a leak; rotating invalidates every issued
# access + refresh token (refresh tokens are also stored in the DB and can be
# revoked via fastify.revokeAllUserRefreshTokens).
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars-long-change-in-production"

# Access token expiration time (default: 15m)
JWT_ACCESS_EXPIRY=15m

# Refresh token expiration time (default: 7d)
JWT_REFRESH_EXPIRY=7d

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
# Server port (default: 3001)
PORT=3001

# Node environment: development, production, test
NODE_ENV=development

# API URL for documentation (default: http://localhost:3001)
API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Security Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS
# In production, set this to your frontend domain(s)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Trust proxy headers (set to 'true' if behind a reverse proxy like nginx)
TRUST_PROXY=false

# Maximum request body size in bytes (default: 1MB)
MAX_BODY_SIZE=1048576

# Request timeout in milliseconds (default: 30000)
REQUEST_TIMEOUT=30000

# Connection timeout in milliseconds (default: 5000)
CONNECTION_TIMEOUT=5000

# ------------------------------------------------------------------------------
# Performance & Caching
# ------------------------------------------------------------------------------
# Cache TTL in milliseconds (default: 300000 = 5 minutes)
CACHE_TTL=300000

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# Log level: trace, debug, info, warn, error, fatal (default: info)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Payments — M-Pesa Daraja (Sandbox)
# ------------------------------------------------------------------------------
# See https://developer.safaricom.co.ke/. Use 'sandbox' for testing.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Default sandbox till. Replace with your paybill / till for production.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS URL that Daraja will POST results to.
# Local: tunnel the backend (port 3001) OR the frontend (port 3000).
#   Backend tunnel → https://<tunnel>/payments/mpesa/callback
#   Frontend tunnel → https://<tunnel>/api/payments/mpesa/callback
# Production: prefer the Railway backend URL:
#   https://<railway-host>/payments/mpesa/callback
MPESA_CALLBACK_URL=https://example.com/payments/mpesa/callback
# Daraja never signs its callbacks, so this pre-shared secret is appended to
# MPESA_CALLBACK_URL as ?key=... and checked on every callback request.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPESA_CALLBACK_SECRET=

# ------------------------------------------------------------------------------
# Payments — PayPal (Sandbox)
# ------------------------------------------------------------------------------
# Get sandbox credentials at https://developer.paypal.com/dashboard/applications
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the PayPal dashboard (Apps & Credentials > your app >
# Webhooks). Required — without it, incoming webhooks are rejected rather
# than trusted unverified (see C2 in the security review).
PAYPAL_WEBHOOK_ID=

# ------------------------------------------------------------------------------
# Payments — Stripe (Test mode)
# ------------------------------------------------------------------------------
# Use sk_test_* / whsec_* / pk_test_* keys. NEVER commit live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The publishable key is consumed by the frontend, mirrored here for awareness.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# The frontend also needs PayPal's public client id for the buttons SDK.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ------------------------------------------------------------------------------
# Email (transactional — order confirmations, password reset)
# ------------------------------------------------------------------------------
# Resend is preferred when configured. The sender domain must be verified.
RESEND_API_KEY=
RESEND_FROM="SokoAfrica Support <support@sokoafrica.com>"
# SMTP remains available as a fallback when RESEND_API_KEY is empty.
# Leave SMTP_HOST empty in dev to log emails as JSON via nodemailer jsonTransport.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Or use a single connection URL: SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="SokoAfrica Support <support@sokoafrica.com>"
# Public storefront URL used in email links
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# File uploads (seller product images)
# ------------------------------------------------------------------------------
# Defaults to apps/backend/public/products when unset
UPLOAD_DIR=

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
SENTRY_DSN=
# Frontend reads NEXT_PUBLIC_SENTRY_DSN (set in apps/frontend/.env.local)

# ------------------------------------------------------------------------------
# Rate limiting (production defaults)
# ------------------------------------------------------------------------------
RATE_LIMIT_MAX=60
