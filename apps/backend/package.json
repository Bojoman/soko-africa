{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "node --experimental-strip-types --no-warnings=ExperimentalWarning prisma/seed.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--experimental-strip-types --no-warnings=ExperimentalWarning\" fastify start -l info -P --plugin-timeout=30000 app.js",
    "start": "cross-env NODE_OPTIONS=\"--experimental-strip-types --no-warnings=ExperimentalWarning\" node server.js",
    "start:cli": "cross-env NODE_OPTIONS=\"--experimental-strip-types --no-warnings=ExperimentalWarning\" fastify start -l info -a 0.0.0.0 --plugin-timeout=30000 app.js",
    "test": "node --experimental-strip-types --test --test-concurrency=1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node --experimental-strip-types --no-warnings=ExperimentalWarning prisma/seed.js"
  },
  "dependencies": {
    "@soko/units": "workspace:*",
    "@fastify/autoload": "^6.3.1",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.60.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "fastify-raw-body": "^5.0.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.12",
    "@types/pg": "^8.11.10",
    "cross-env": "^7.0.3",
    "fastify-cli": "^8.0.0",
    "prisma": "^7.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
