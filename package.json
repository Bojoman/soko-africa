{
  "name": "soko-africa-root",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "frontend:dev": "pnpm --filter frontend dev",
    "frontend:build": "pnpm --filter frontend build",
    "backend:dev": "pnpm --filter backend dev",
    "backend:start": "pnpm --filter backend start",
    "db:seed": "pnpm --filter backend run db:seed",
    "db:migrate": "pnpm --filter backend exec prisma migrate deploy",
    "dev": "concurrently -n backend,frontend -c blue,green \"pnpm run backend:dev\" \"pnpm run frontend:dev\"",
    "build": "pnpm --filter frontend build",
    "lint": "pnpm --filter frontend lint",
    "type-check": "pnpm --filter frontend type-check",
    "clean": "pnpm -r exec rm -rf node_modules .next dist",
    "update-deps": "pnpm -r update --latest"
  },
  "devDependencies": {
    "@types/node": "^22.15.12",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.8.4",
      "hono": ">=4.12.25"
    }
  }
}
