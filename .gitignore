# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
dist
build
*.tsbuildinfo

# Environment variables — broad match (covers .env.production, .env.staging,
# etc., not just .env/.env.local) with an explicit exception for the
# checked-in example template (see M4 in the security review). The frontend
# has its own .gitignore with the equivalent !.env.example exception, since a
# parent .gitignore's negation can't re-include a path a nested .gitignore
# already excludes.
.env*
!apps/backend/.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage
.nyc_output

# IDE
.idea
.vscode
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Database
*.sqlite
*.sqlite3

# Cache
.cache
*.cache

# Temporary files
tmp
temp
*.tmp
.tmp/

# Prisma
apps/backend/prisma/migrations/*/migration_lock.toml
apps/backend/prisma/generated/
